#################################
# Z4c splitting benchmark: gauge wave, 256^3.
#
# Identical to gauge_wave_z4c_bench.par except for the grid size, so the
# RHS timing is directly comparable per-iteration; the absolute time is
# ~8x larger because the volume is.
#
# Derived from recipes/Cottonmouth/apples_with_apples/gauge_wave_z4c.par.
# This is a *benchmark*, not a convergence test, so it differs from that
# parfile in three deliberate ways:
#
#   1. The grid is a cube instead of 50x8x8. The gauge wave depends only on
#      x and t (see recipes/Cottonmouth/gauge_wave.py:129), so extending y
#      and z changes nothing physically -- it just gives the RHS kernel a
#      realistically shaped 3D block to work on. An 8-cell direction with
#      ghost_size 3 is almost all ghost zone and would not measure what the
#      splitting actually costs in production.
#   2. It terminates at a fixed small iteration count so one trial is minutes,
#      not the 200000 iterations the apples-with-apples run does.
#   3. TimerReport is active and writes AllTimersReadable.txt, which is what
#      timings.sh reads the ODESolvers::Solve::rhs total out of.
#
# Output and poisoning are off: both add time that has nothing to do with the
# split, and the tuner is fitting a curve to these numbers, so noise costs
# real trials.
#################################
$ncells     = 256   # Cells per side (8x the volume of the 128 benchmark).
$itlast     = 200   # Fixed across trials, so total RHS seconds are comparable.
$dtfac      = 0.25  # CFL
#################################

ActiveThorns = "
  ADMBaseX
  TmunuBaseX
  CarpetX
  CottonmouthZ4c4m
  IOUtil
  CottonmouthGaugeWaveID
  ODESolvers
  TimerReport
"

# Driver
Cactus::cctk_show_schedule       = no
Cactus::presync_mode             = "presync-only"
CarpetX::verbose                 = no
CarpetX::poison_undefined_values = no

# Run Termination
Cactus::terminate   = "iteration"
Cactus::cctk_itlast = $itlast

# Grid setup
CarpetX::xmin = -0.5
CarpetX::ymin = -0.5
CarpetX::zmin = -0.5

CarpetX::xmax = 0.5
CarpetX::ymax = 0.5
CarpetX::zmax = 0.5

CarpetX::ncells_x = $ncells
CarpetX::ncells_y = $ncells
CarpetX::ncells_z = $ncells

CarpetX::blocking_factor_x = 8
CarpetX::blocking_factor_y = 8
CarpetX::blocking_factor_z = 8

CarpetX::max_grid_size_x = 64
CarpetX::max_grid_size_y = 64
CarpetX::max_grid_size_z = 64

# Tiling must be disabled for GPU runs.
CarpetX::max_tile_size_x = 102400000
CarpetX::max_tile_size_y = 102400000
CarpetX::max_tile_size_z = 102400000

CarpetX::ghost_size = 3

# Boundary conditions
CarpetX::periodic   = yes
CarpetX::periodic_x = yes
CarpetX::periodic_y = yes
CarpetX::periodic_z = yes

# Initial data
ADMBaseX::initial_data    = "none"
ADMBaseX::initial_lapse   = "none"
ADMBaseX::initial_shift   = "none"
ADMBaseX::initial_dtlapse = "none"
ADMBaseX::initial_dtshift = "none"

# Time Integration
ODESolvers::verbose = no
CarpetX::dtfac      = $dtfac
ODESolvers::method  = "RK4"

# Output -- nothing but the timers.
IO::out_dir   = $parfile
IO::out_every = -1

CarpetX::out_metadata    = no
CarpetX::out_performance = no
CarpetX::out_tsv         = no

# Timer output. output_all_timers_readable writes <out_dir>/AllTimersReadable.txt
# with columns: iteration, time, timer#, avg, min, max, name.
TimerReport::out_every                  = $itlast
TimerReport::out_filename               = "TimerReport"
TimerReport::n_top_timers               = 200
TimerReport::output_all_timers          = no
TimerReport::output_all_timers_together = no
TimerReport::output_all_timers_readable = yes
TimerReport::output_schedule_timers     = no
